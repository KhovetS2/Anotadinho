{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Anotadinho",
  "version": "0.1.0",
  "identifier": "com.khovet.anotadinho",
  "build": {
    "beforeDevCommand": "cd ../ui && trunk serve --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../ui && trunk build --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anotadinho",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
