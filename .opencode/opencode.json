{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": { "DISPLAY": ":0" }
    }
  }
}
